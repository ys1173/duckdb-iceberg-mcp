# ── Full mode (JWT auth) ──────────────────────────────────────────────────────
MCP_MODE=full
MCP_TRANSPORT=http           # http (Streamable HTTP) | sse

# ── Auth: IdP-agnostic JWT validation ─────────────────────────────────────────
JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
JWT_AUDIENCE=duckdb-iceberg-mcp      # must match the 'aud' claim in issued tokens

# ── Catalog ───────────────────────────────────────────────────────────────────
CATALOG_TYPE=glue

# Glue / S3 — choose one auth method:
#   Option A: named profile
# AWS_PROFILE=default
#   Option B: explicit credentials
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# ── Safety ────────────────────────────────────────────────────────────────────
WRITE_MODE=disabled          # set to 'enabled' to allow INSERT/UPDATE/DELETE/DDL
MAX_ROWS=250
MAX_CHARS=40000

# ── HTTP transport ────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000
# MCP_ALLOWED_HOSTS=host.docker.internal:*,localhost:*
