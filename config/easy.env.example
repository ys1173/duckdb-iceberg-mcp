# Legacy AWS Glue example. FFWD users: use config/ffwd.env.example instead.
# Easy mode controls incoming MCP authentication, not catalog OAuth.
MCP_MODE=easy
MCP_TRANSPORT=stdio          # stdio | http | sse (localhost by default)

# Optional: require a static API key for HTTP/SSE transport
# MCP_API_KEY=change-me

# ── Catalog ─────────────────────────────────────���─────────────────────────────
CATALOG_TYPE=glue

# Glue / S3 — choose one auth method:
#   Option A: named profile
# AWS_PROFILE=default
#   Option B: explicit credentials
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# ── Safety ─────────────────────────────────────────────���──────────────────────
# WRITE_MODE is always disabled in easy mode — this setting is ignored
MAX_ROWS=250
MAX_CHARS=40000
QUERY_TIMEOUT_SECONDS=30
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=4

# ── MCP client sessions ────────────────────────────────────────────────────────
# HTTP/SSE: each MCP client should send X-MCP-Session-ID (override name with MCP_SESSION_HEADER).
# Up to MAX_SESSIONS DuckDB connections; LRU closes excess. Omit header → shared "default" slot.
# MAX_SESSIONS=50
# MCP_SESSION_HEADER=X-MCP-Session-ID
# stdio: optional fixed key per client process (defaults to "default" if unset)
# MCP_SESSION_ID=my-desktop-codex

# ── HTTP transport (only used when MCP_TRANSPORT=http or sse) ─────────────────
MCP_PORT=8000
# MCP_ALLOWED_HOSTS=host.docker.internal:*,localhost:*
