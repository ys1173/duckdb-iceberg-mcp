# Copy values from FFWD > Data Lake Destination > Query Engine > DuckDB.
# Or run: duckdb-iceberg setup --from-sql ffwd-connection.sql --env-file .env
CATALOG_TYPE=rest
CATALOG_NAME=ffwd
FFWD_CATALOG_ENDPOINT=https://<cluster>/api/tenants/<tenant-id>/iceberg/catalog
FFWD_OAUTH_TOKEN_ENDPOINT=https://<cluster>/api/oauth/token
FFWD_WAREHOUSE_ID=<warehouse-id-from-ATTACH>
FFWD_CLIENT_ID=<agent-key-id>
FFWD_CLIENT_SECRET=<agent-key-secret>
# Default: catalog provides scoped S3 credentials; no AWS keys required.
ACCESS_DELEGATION_MODE=vended_credentials
MCP_MODE=easy
MCP_TRANSPORT=stdio
MAX_ROWS=250
MAX_CHARS=40000
QUERY_TIMEOUT_SECONDS=30
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=4
# MCP launchers can instead set DUCKDB_MCP_ENV_FILE=/absolute/path/to/.env
